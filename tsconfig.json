{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
        "paths": {
            "@wtroiano/chart-builder-sdk": ["./packages/sdk/src/index.ts"]
        }
    },
    "include": [
        "resources/react",
        "packages/sdk/src",
        "tests/react",
        "tests/adapters",
        "tests/browser",
        "*.ts",
        "examples/react"
    ]
}
