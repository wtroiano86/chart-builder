{
    "manifestSchemaVersion": 1,
    "name": "shadcn",
    "apiVersion": 1,
    "manifestVersion": "1.1.0",
    "payloadSchemaVersions": [1],
    "sdkRange": "^0.1.0",
    "reactRange": "^18.0.0 || ^19.0.0",
    "engine": {
        "package": "recharts",
        "range": "~3.10.1"
    },
    "datasetKinds": ["rows"],
    "series": {
        "line": {
            "datasetKinds": ["rows"],
            "coordinates": ["cartesian"],
            "roles": {
                "x": {
                    "dimensionTypes": [
                        "string",
                        "number",
                        "boolean",
                        "date",
                        "datetime"
                    ],
                    "minFields": 1,
                    "maxFields": 1,
                    "required": true
                },
                "y": {
                    "dimensionTypes": ["number"],
                    "minFields": 1,
                    "maxFields": 1,
                    "required": true
                }
            }
        },
        "bar": {
            "datasetKinds": ["rows"],
            "coordinates": ["cartesian"],
            "roles": {
                "x": {
                    "dimensionTypes": [
                        "string",
                        "number",
                        "boolean",
                        "date",
                        "datetime"
                    ],
                    "minFields": 1,
                    "maxFields": 1,
                    "required": true
                },
                "y": {
                    "dimensionTypes": ["number"],
                    "minFields": 1,
                    "maxFields": 1,
                    "required": true
                }
            }
        },
        "pie": {
            "datasetKinds": ["rows"],
            "coordinates": ["none"],
            "roles": {
                "label": {
                    "dimensionTypes": [
                        "string",
                        "number",
                        "boolean",
                        "date",
                        "datetime"
                    ],
                    "minFields": 1,
                    "maxFields": 1,
                    "required": true
                },
                "value": {
                    "dimensionTypes": ["number"],
                    "minFields": 1,
                    "maxFields": 1,
                    "required": true
                }
            }
        }
    },
    "mixedSeries": [
        {
            "coordinate": "cartesian",
            "types": ["line", "bar"]
        }
    ],
    "features": {
        "series.stack": {
            "scopes": ["series"],
            "optionsSchema": {
                "type": "object",
                "additionalProperties": false
            }
        },
        "series.area": {
            "scopes": ["series"],
            "optionsSchema": {
                "type": "object",
                "additionalProperties": false
            }
        },
        "series.step": {
            "scopes": ["series"],
            "optionsSchema": {
                "type": "object",
                "additionalProperties": false
            }
        },
        "series.smooth": {
            "scopes": ["series"],
            "optionsSchema": {
                "type": "object",
                "additionalProperties": false
            }
        },
        "format.custom": {
            "scopes": ["chart"],
            "optionsSchema": {
                "type": "object",
                "additionalProperties": false
            }
        },
        "interaction.point-activate": {
            "scopes": ["chart", "series"],
            "optionsSchema": {
                "type": "object",
                "additionalProperties": false
            }
        }
    },
    "renderingModes": ["svg"],
    "exports": [
        { "format": "svg", "modes": ["svg"] },
        { "format": "png", "modes": ["svg"] }
    ]
}
