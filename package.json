{
    "name": "chart-builder-development",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.preview.config.ts",
        "screenshots": "node scripts/screenshots.mjs",
        "build": "npm run build:sdk && vite build --config vite.preview.config.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:browser": "playwright test",
        "check": "npm run check:schema && npm run typecheck && npm run format:check && npm test && npm run build",
        "format": "prettier --write resources/react examples/react packages/sdk/src tests/react tests/adapters tests/browser scripts *.ts package.json tsconfig.json",
        "format:check": "prettier --check resources/react examples/react packages/sdk/src tests/react tests/adapters tests/browser scripts *.ts package.json tsconfig.json",
        "build:sdk": "npm run build --workspace=@wtroiano/chart-builder-sdk",
        "schemas": "node scripts/generate-schemas.mjs",
        "test:package": "node scripts/test-package.mjs",
        "pretest": "npm run build:sdk",
        "check:schema": "node scripts/generate-schemas.mjs --check"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@inertiajs/react": "3.9.1",
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "@wtroiano/chart-builder-fixture": "file:tests/adapters/fixture",
        "@wtroiano/chart-builder-sdk": "file:packages/sdk",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "echarts": "6.1.0",
        "jsdom": "30.1.3",
        "prettier": "3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-is": "19.3.1",
        "recharts": "3.10.1",
        "tailwindcss": "4.3.3",
        "ts-json-schema-generator": "^2.4.0",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "workspaces": [
        "packages/sdk",
        "tests/adapters/fixture"
    ]
}
